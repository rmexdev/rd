{
    "name": "@rd/source",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "dev": "pnpm --filter core run dev",
        "test": "pnpm typecheck && vitest",
        "typecheck": "tsc -b --noEmit",
        "lint": "eslint --fix && prettier --write",
        "new-package": "f() { nx g @rd/workspace-plugin:new-package packages/$1; }; f",
        "reset-node-modules": "./tools/scripts/reset-node-modules.sh",
        "prepare": "husky"
    },
    "private": true,
    "devDependencies": {
        "@eslint/js": "^9.8.0",
        "@nx/devkit": "22.7.7",
        "@nx/eslint": "22.6.5",
        "@nx/eslint-plugin": "22.6.5",
        "@nx/js": "22.7.7",
        "@nx/playwright": "22.7.7",
        "@nx/plugin": "22.6.5",
        "@nx/react": "22.7.7",
        "@nx/vite": "22.7.7",
        "@nx/vitest": "22.7.7",
        "@nx/web": "22.7.7",
        "@playwright/test": "^1.36.0",
        "@swc-node/register": "~1.11.1",
        "@swc/cli": "~0.8.0",
        "@swc/core": "~1.15.5",
        "@swc/helpers": "~0.5.18",
        "@testing-library/dom": "10.4.0",
        "@testing-library/react": "16.3.0",
        "@types/node": "20.19.9",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.0.0",
        "@vitest/coverage-v8": "~4.1.0",
        "@vitest/ui": "~4.1.0",
        "eslint": "^9.8.0",
        "eslint-config-prettier": "^10.0.0",
        "husky": "^9.1.7",
        "jsonc-eslint-parser": "^2.1.0",
        "lint-staged": "^17.3.0",
        "nx": "22.6.5",
        "pkgroll": "^2.27.1",
        "prettier": "~3.6.2",
        "tslib": "^2.3.0",
        "tsx": "^4.23.1",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.40.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.10"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,md,html,css}": "pnpm lint"
    },
    "workspaces": [
        "packages/*",
        "tools/*"
    ],
    "dependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    }
}
