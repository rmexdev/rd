{
	"Create an Identifier": {
		"scope": "typescript",
		"prefix": "id",
		"body": [
			"import { Guard, Identifier, Result } from '@rd/core';",
			"",
			"export type $1Result = Result<$1>;",
			"",
			"export class $1 extends Identifier<string> {",
			"    static create (id: string): $1Result {",
			"        const guardResult = Guard.againstEmptyString(id, 'id');",
			"        if (!guardResult.succeeded) {",
			"            return Result.fail(guardResult.message);",
			"        }",
			"    ",
			"        return Result.ok(new $1(id));",
			"    }",
			"",
			"    private constructor(id: string) {",
			"        super(id);",
			"    }",
			"}",
		],
		"description": "Create an identifier file"
	},
	"Create an Entity": {
		"scope": "typescript",
		"prefix": "entity",
		"body": [
			"import { Entity, Guard, Result } from '@rd/core';",
			"",
			"export type ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Props = {",
			"    $1",
			"}",
			"",
			"export type ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Result = Result<${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}>;",
			"",
			"export class ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/} extends Entity<${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Props> {    ",
			"    static create (props: ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Props, id: ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Id): ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Result {",
			"        const guardResult = Guard.againstNullOrUndefinedBulk([",
			"            { argument: id, argumentName: 'id'},",
			"            { argument: $2 }",
			"        ]);",
			"        if (!guardResult.succeeded) {",
			"            return Result.fail(guardResult.message);",
			"        }",
			"        ",
			"        return Result.ok(new ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}(props, id));",
			"    }",
			"    ",
			"    private constructor(props: ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Props, id: ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Id) {",
			"        super(props, id);",
			"    }",
			"",
			"    get id() : ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Id {",
			"        return this.id;",
			"    }",
			"}"
		],
		"description": "Create an entity file"
	},
    "Create an Value Object": {
		"scope": "typescript",
		"prefix": "vo",
		"body": [
			"import { Guard, Result, ValueObject } from '@rd/core';",
			"",
			"export type ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Props = {",
			"    value: $1",
			"}",
			"",
			"export type ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Result = Result<${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}>;",
			"",
			"export class ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/} extends ValueObject<${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Props> {",
			"    static create (props: ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Props): ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Result {",
			"        const guardResult = Guard.againstNullOrUndefined(props.value, 'value');",
			"        if (!guardResult.succeeded) {",
			"            return Result.fail(guardResult.message);",
			"        }",
			"    ",
			"        return Result.ok(new ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}(props));",
			"    }",
			"",
			"    private constructor(props: ${TM_FILENAME_BASE/^(.*?)\\..*/${1:/pascalcase}/}Props) {",
			"        super(props);",
			"    }",
			"",
			"    get value(): $1 {",
			"        return this.props.value",
			"    }",
			"}"
		],
		"description": "Create an entity file"
	},
	"Guard Result": {
		"scope": "typescript",
		"prefix": "gr",
		"body": [
			"const guardResult = Guard.$1($2);",
			"if (!guardResult.succeeded) {",
			"    return Result.fail(guardResult.message);",
			"}",
			"",
			"return Result.ok($3);"
		],
